# Copy to .env and fill in your values. Real environment variables take precedence.

# Namecheap API credentials (Profile > Tools > API Access)
NAMECHEAP_API_USER=your_api_user
NAMECHEAP_API_KEY=your_api_key
NAMECHEAP_USERNAME=your_username

# Public IPv4 address whitelisted in Namecheap API Access
NAMECHEAP_CLIENT_IP=203.0.113.10

# true to use api.sandbox.namecheap.com, false for production
NAMECHEAP_USE_SANDBOX=false

# Optional: profile from ~/.config/dotseek config to use by default
# DOTSEEK_PROFILE=
