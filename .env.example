# Copy to .env and fill in your values. Real environment variables take precedence.

# Optional: which registrar API answers availability checks: namecheap or
# cloudflare. When unset, Cloudflare is used if only CLOUDFLARE_* credentials
# are present; otherwise Namecheap.
# DOTSEEK_PROVIDER=namecheap

# Namecheap API credentials (Profile > Tools > API Access)
NAMECHEAP_API_USER=your_api_user
NAMECHEAP_API_KEY=your_api_key
NAMECHEAP_USERNAME=your_username

# Public IPv4 address whitelisted in Namecheap API Access
NAMECHEAP_CLIENT_IP=203.0.113.10

# true to use api.sandbox.namecheap.com, false for production
NAMECHEAP_USE_SANDBOX=false

# Cloudflare Registrar API credentials (dash.cloudflare.com > API Tokens,
# with Registrar permissions). Set these instead of the NAMECHEAP_* values.
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_api_token
# true to use the registrar-sandbox endpoints, false for production
# CLOUDFLARE_USE_SANDBOX=false

# Optional: profile from ~/.config/dotseek config to use by default
# DOTSEEK_PROFILE=
